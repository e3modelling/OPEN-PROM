    "version": "2.0.0",
    "tasks": [
        // ---- Single-scenario task buttons (task 0 ... task 8) ----
        {
            "label": "OPEN-PROM DEV",
            "type": "shell",
            "command": "Rscript start.R task_id=0",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "focus": true
            }
        },

        {
            "label": "OPEN-PROM DEV NEW DATA",
            "type": "shell",
            "command": "Rscript start.R task_id=1",
            "problemMatcher": [],
