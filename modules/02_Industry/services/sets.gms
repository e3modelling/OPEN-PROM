IND_SERVStoEF(IND_SERVS,EF)

IS_TRANSF "IS transformation routes" /BLASTFUR,COKEOVS,DRI/

IS_TRANSF_OUT(IS_TRANSF,EF)   "Energy outputs of IS transformation processes"
/
