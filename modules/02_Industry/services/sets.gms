*' @title Industry Sets
*' @code

*---
sets

ICTSCEN "Scenarios for projected ICT growth" /Lower,Upper,Central,Mean/
IND_SERVS "Industry & Domestic energy services" /PRIM_STEEL,SEC_STEEL,OTHER/

INDDOMtoSERVS(INDDOM,IND_SERVS)    "Mapping between industry"
/
IS.(PRIM_STEEL,SEC_STEEL)
/

INDITECH(TECH)
/
BOF     "Basic oxygen furnace"
NGEAF     "Direct reduction electric arc furnace fed ny natural gas for primary steel production"
H2EAF     "Direct reduction electric arc furnace fed ny hydrogen for primary steel production"
SCREAF    "Electric arc furnace for secondary steel production"  
TGDO
TLPG
TKRS
TNGS
TELC
TLGN
THCL
THCLCCS
TRFO
TOLQ
TOGS
TGSL
TSTE
TBMSWAS
TH2F
TSOL
TGEO
/

CCSITECH(INDITECH) /THCLCCS/

SERVStoTECH(IND_SERVS,INDITECH)
/
PRIM_STEEL.(BOF,NGEAF,H2EAF)
SEC_STEEL.SCREAF
OTHER.(TGDO,TLPG,TKRS,TNGS,TELC,TLGN,THCL,TRFO,TOLQ,TOGS,TGSL,TSTE,TBMSWAS,TH2F,TSOL,TGEO)
/

INDITECHTOEF(INDITECH,EF)
/
BOF.(BFG,COG,COKE,ELC)
NGEAF.(ELC,HCL,NGS,BMSWAS,STE,RFO,GDO,OLQ,LPG,LGN)
H2EAF.(ELC,HCL,H2F,BMSWAS)
SCREAF.(ELC,HCL,NGS,BMSWAS,STE,RFO,GDO,OLQ,LPG,LGN)
TGDO.(GDO,BGDO,CRO)
TLPG.LPG
TKRS.(KRS,BKRS)
TNGS.(NGS,BGAS)
TELC.ELC
TLGN.LGN
THCL.(HCL,COKE)
TRFO.RFO
TOLQ.OLQ
TOGS.(OGS,BFG,COG)
TGSL.(GSL,BGSL)
TSTE.STE
TH2F.H2F
TBMSWAS.BMSWAS
TSOL.SOL
TGEO.GEO
/

IND_SERVStoEF(IND_SERVS,EF)

IS_TRANSF "IS transformation routes" /BLASTFUR,COKEOVS,DRI/

IS_TRANSF_OUT(IS_TRANSF,EF)   "Energy outputs of IS transformation processes"
/
BLASTFUR.(BFG)
COKEOVS.(COKE,COG)
/

;

INDDOMtoSERVS(INDDOM,"OTHER")$(not sameas("IS", INDDOM)) = yes;
IND_SERVStoEF(IND_SERVS,EF) = yes$SUM(INDITECH$(SERVStoTECH(IND_SERVS,INDITECH) and INDITECHTOEF(INDITECH,EF)), 1);
SECtoEF(INDDOM,EF) = yes$SUM(IND_SERVS$IND_SERVStoEF(IND_SERVS,EF), 1);
alias(INDITECH, INDITECH2);
