*' @title INDUSTRY  - DOMESTIC - NON ENERGY USES - BUNKERS VARIABLES Preloop
*' @code
 
*'                *VARIABLE INITIALISATION*
V02EnergyService.LO(runCy,INDDOM,IND_SERVS,YTIME) = 0;
V02EnergyService.L(runCy,INDDOM,IND_SERVS,YTIME) = 1;
V02EnergyService.FX(runCy,INDDOM,IND_SERVS,YTIME)$(DATAY(YTIME) and INDDOMtoSERVS(INDDOM,IND_SERVS)) = i02DataEnergyService(runCy,INDDOM,IND_SERVS,YTIME);
V02EnergyService.FX(runCy,INDDOM,IND_SERVS,YTIME)$(not INDDOMtoSERVS(INDDOM,IND_SERVS)) = 0;
*---
V02Capacity.LO(runCy,INDDOM,IND_SERVS,INDITECH,YTIME) = 0;
V02Capacity.L(runCy,INDDOM,IND_SERVS,INDITECH,YTIME) = 1;
V02Capacity.FX(runCy,INDDOM,IND_SERVS,INDITECH,YTIME)$DATAY(YTIME) = i02Capacity(runCy,INDDOM,IND_SERVS,INDITECH,YTIME);
V02Capacity.FX(runCy,INDDOM,IND_SERVS,INDITECH,YTIME)$(not (INDDOMtoSERVS(INDDOM,IND_SERVS) and SERVStoTECH(IND_SERVS,INDITECH))) = 0;
*---
V02GapCapacity.LO(runCy,INDDOM,IND_SERVS,YTIME) = 0;
*---
V02ShareTech.LO(runCy,INDDOM,IND_SERVS,INDITECH,YTIME) = 0;
V02ShareTech.UP(runCy,INDDOM,IND_SERVS,INDITECH,YTIME) = 1;
*---
V02ScrpRate.LO(runCy,INDDOM,IND_SERVS,INDITECH,YTIME) = 0;
V02ScrpRate.UP(runCy,INDDOM,IND_SERVS,INDITECH,YTIME) = 1;
*---
V02CostTotal.LO(runCy,INDDOM,IND_SERVS,INDITECH,YTIME) = 0;
V02CostTotal.L(runCy,INDDOM,IND_SERVS,INDITECH,YTIME) = 1;
V02CostTotal.FX(runCy,INDDOM,IND_SERVS,INDITECH,YTIME)$DATAY(YTIME) = 1;
V02CostTotal.FX(runCy,INDDOM,IND_SERVS,INDITECH,YTIME)$(not (INDDOMtoSERVS(INDDOM,IND_SERVS) and SERVStoTECH(IND_SERVS,INDITECH))) = 0;
*---
V02ConsFuel.LO(runCy,INDDOM,IND_SERVS,EF,YTIME) = 0;
V02ConsFuel.L(runCy,INDDOM,IND_SERVS,EF,YTIME) = i02FuelConsPerService(runCy,INDDOM,IND_SERVS,EF,"%fBaseY%");
V02ConsFuel.FX(runCy,INDDOM,IND_SERVS,EF,YTIME)$DATAY(YTIME) = i02FuelConsPerService(runCy,INDDOM,IND_SERVS,EF,YTIME);
V02ConsFuel.FX(runCy,INDDOM,IND_SERVS,EF,YTIME)$(not (INDDOMtoSERVS(INDDOM,IND_SERVS) and IND_SERVStoEF(IND_SERVS,EF))) = 0;
*---
V02ISTransfOutEF.LO(runCy,IS_TRANSF,EFS,YTIME) = 0;
V02ISTransfOutEF.L(runCy,IS_TRANSF,EFS,YTIME) = i02ISTransfOutEF(runCy,IS_TRANSF,EFS,"%fBaseY%");
V02ISTransfOutEF.FX(runCy,IS_TRANSF,EFS,YTIME)$DATAY(YTIME) = i02ISTransfOutEF(runCy,IS_TRANSF,EFS,YTIME);
V02ISTransfOutEF.FX(runCy,IS_TRANSF,EFS,YTIME)$(not IS_TRANSF_OUT(IS_TRANSF,EFS)) = 0;
*---
V02ISTransfInEF.LO(runCy,IS_TRANSF,EFS,YTIME) = 0;
V02ISTransfInEF.L(runCy,IS_TRANSF,EFS,YTIME) = -i02ISTransfInEF(runCy,IS_TRANSF,EFS,"%fBaseY%");
V02ISTransfInEF.FX(runCy,IS_TRANSF,EFS,YTIME)$DATAY(YTIME) = -i02ISTransfInEF(runCy,IS_TRANSF,EFS,YTIME);
*---
V02CostVariable.LO(runCy,INDDOM,IND_SERVS,INDITECH,YTIME) = 0;
V02CostVariable.L(runCy,INDDOM,IND_SERVS,INDITECH,YTIME) = 1;
V02CostVariable.FX(runCy,INDDOM,IND_SERVS,INDITECH,YTIME)$DATAY(YTIME) = 
SUM(EFS$INDITECHTOEF(INDITECH,EFS),
  (
    VmPriceFinal.L(runCy,INDDOM,EFS,YTIME-1) +
    imCO2CaptRateIndustry(runCy,INDITECH,YTIME) * VmCstCO2SeqCsts.L(runCy,YTIME) * 1e-3 * imCo2EmiFac(runCy,INDDOM,EFS,YTIME) +
    (1-imCO2CaptRateIndustry(runCy,INDITECH,YTIME)) * 1e-3 * VmPriceCarbon.L(runCy,INDDOM,EFS,YTIME-1) * imCo2EmiFac(runCy,INDDOM,EFS,YTIME)
  ) * i02SFC(runCy,INDDOM,IND_SERVS,INDITECH,EFS,"%fBaseY%")
);
*---
V02CostCapital.LO(runCy,INDDOM,IND_SERVS,INDITECH,YTIME) = 0;
V02CostCapital.L(runCy,INDDOM,IND_SERVS,INDITECH,YTIME) = 1;
V02CostCapital.FX(runCy,INDDOM,IND_SERVS,INDITECH,YTIME)$DATAY(YTIME) = 1;
*---
V02CostTotal.LO(runCy,INDDOM,IND_SERVS,INDITECH,YTIME) = 0;
V02CostTotal.FX(runCy,INDDOM,IND_SERVS,INDITECH,YTIME)$DATAY(YTIME) = V02CostCapital.L(runCy,INDDOM,IND_SERVS,INDITECH,YTIME) + V02CostVariable.L(runCy,INDDOM,IND_SERVS,INDITECH,YTIME);
*---
V02ISownEnergyTransf.LO(runCy,IS_TRANSF,EFS,YTIME) = 0;
V02ISownEnergyTransf.L(runCy,IS_TRANSF,EFS,YTIME) = i02OwnEnergyTransf(runCy,IS_TRANSF,EFS,"%fBaseY%");
V02ISownEnergyTransf.FX(runCy,IS_TRANSF,EFS,YTIME)$DATAY(YTIME) = i02OwnEnergyTransf(runCy,IS_TRANSF,EFS,YTIME);
*---
V02ScrpRatePrem.LO(runCy,INDDOM,IND_SERVS,INDITECH,YTIME) = 0;
V02ScrpRatePrem.UP(runCy,INDDOM,IND_SERVS,INDITECH,YTIME) = 1;
V02ScrpRatePrem.FX(runCy,INDDOM,IND_SERVS,INDITECH,YTIME)$(not (INDDOMtoSERVS(INDDOM,IND_SERVS) and SERVStoTECH(IND_SERVS,INDITECH))) = 0;