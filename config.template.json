{
  "paths": {
    "model_runs_path": "local/path/to/model/runs/",
    "magpie_path": "path/to/magpie/folder/including/trailing/slash/",
    "gams_path": "path/to/gams/folder/including/trailing/slash/"
  },
  "behavior": {
    "withRunFolder": true,
    "withSync": true,
    "withReport": true,
    "uploadGDX": true
  },
  "scenario": {
    "scenario_name": "SCEN",
    "description": "Replace with your scenario description.",
    "gams_flags": {
      "fScenario": 200,
      "fEndY": 2100,
      "CountrySolveMode": "serial",
      "biomassReferenceEJ": 150,
      "ccsStorageReferenceGtCO2": 400
    },
    "land_use_emulator": {
      "source": "magpie",
      "carbon_price_scenario": "Npi_Default"
    },
    "maturity_factors": {
      "levels":  { "low": 0.5, "def": 1, "high": 2 },
      "changes": {
        "solar":      { "tech": "PGSOL",     "mult": "def" },
        "windOffLam": { "tech": "PGAWNO",    "mult": "def", "region": "LAM" },
        "bmsccsMid":  { "tech": "ATHBMSCCS", "mult": "def", "from": 2030, "to": 2050 },
        "bmsccsLate": { "tech": "ATHBMSCCS", "mult": "def", "from": 2051 },
        "lpgCars":    { "sector": "PC", "tech": "TLPG", "mult": "def" }
      }
    },
    "soft_link_magpie": {
      "project": "uptake",
      "existing_prom_run": null,
      "max_iter": 1,
      "price_tol": 0.05,
      "quant_tol": 0.05
    }
  },
  "global_carbon_price_calibration": {
    "resume_from": null,
    "prefix_policy": "exogCV_NPi",
    "fixed_through_year": 2028,
    "common_year": 2035,
    "common_price": 100,
    "net_zero_year": null,
    "end_year": 2100,
    "budget_start_year": 2020,
    "budget_gtco2": 1150,
    "temperature_case": "2C",
    "search": {
      "net_zero_start_price": null,
      "end_start_price": 400,
      "initial_price_step": 100,
      "max_price": 5000,
      "price_resolution": 1,
      "max_evaluations": 50,
      "net_zero_tolerance_mtco2": 100,
      "budget_tolerance_gtco2": 5
    }
  }
}
